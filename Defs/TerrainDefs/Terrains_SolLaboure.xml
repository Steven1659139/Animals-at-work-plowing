<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Fertilité 1.3 : entre le sol normal (1.0) et le sol riche (1.4).
       Le sol riche n'est jamais labouré (on le dégraderait). La terre se
       tasse après une saison (MapComponent_Labour). -->
  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>AAW_SolLaboure</defName>
    <label>plowed soil</label>
    <description>Earth turned and aerated by a harnessed draft animal. Crops grow noticeably better here than in packed soil. The earth settles back on its own after a season, and will need plowing again.</description>
    <texturePath>Terrain/AAW_SolLaboure</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>336</renderPrecedence>
    <pathCost>3</pathCost>
    <fertility>1.3</fertility>
    <statBases>
      <Beauty>-3</Beauty>
      <BeautyOutdoors>0</BeautyOutdoors>
      <Cleanliness>-1</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
      <li>Diggable</li>
    </affordances>
    <generatedFilth>Filth_Dirt</generatedFilth>
  </TerrainDef>

</Defs>
