<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Texture peinte en tons clairs : le jeu la teinte de la couleur du bois utilisé. -->
  <ThingDef ParentName="ResourceBase">
    <defName>AAW_Grattoir</defName>
    <label>snow scraper</label>
    <description>A broad blade on a stout beam, ready to be hitched. A harnessed draft beast drags it across your snow-clearing area and scrapes the cells bare: winter work for the same beasts whose plows sit idle in frozen ground. The blade wears down and gives out after about four hundred cleared cells in wood, half again as many in steel, and four times as many in plasteel. One implement per beast: plow, cart or scraper.</description>
    <graphicData>
      <texPath>Things/Item/AAW_Grattoir</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>5</stackLimit>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>16</Mass>
      <WorkToMake>4200</WorkToMake>
      <Flammability>1.0</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>AAW_Harnachement</researchPrerequisite>
      <!-- Le coin d'artisanat reste pour la partie qui débute, mais une pièce
           d'attelage se fait aussi bien à la forge, comme les armes néolithiques
           vanilla (arc, épieu, massue, bois et métal mêlés). -->
      <recipeUsers>
        <li>CraftingSpot</li>
        <li>FueledSmithy</li>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <displayPriority>153</displayPriority>
    </recipeMaker>
  </ThingDef>

</Defs>
