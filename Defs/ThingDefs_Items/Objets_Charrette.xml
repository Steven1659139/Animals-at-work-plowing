<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Texture peinte en tons clairs : le jeu la teinte de la couleur du bois utilisé. -->
  <ThingDef ParentName="ResourceBase">
    <defName>AAW_Charrette</defName>
    <label>draft cart</label>
    <description>A two-wheeled wooden cart. Harnessed draft beasts hitch themselves to it, then load several stacks at once (up to 300 kg, riding in plain sight on the bed) and deliver the whole round in one trip. It also grants an extra hundred kilograms in caravans, and wears out after roughly a hundred loaded stacks. One implement per beast: cart, plow or snow scraper.</description>
    <graphicData>
      <texPath>Things/Item/AAW_Charrette</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <stackLimit>5</stackLimit>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>28</Mass>
      <WorkToMake>7000</WorkToMake>
      <Flammability>1.0</Flammability>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <researchPrerequisite>AAW_Charretterie</researchPrerequisite>
      <recipeUsers>
        <li>CraftingSpot</li>
      </recipeUsers>
      <displayPriority>151</displayPriority>
    </recipeMaker>
  </ThingDef>

</Defs>
