<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Insère le comportement déneigeur dans l'arbre de pensée des animaux
       apprivoisés, au même ancrage que l'attelage et le labour : juste après la
       branche Haul. Voir Patch_ArbrePensee_Labour.xml pour la raison de cet
       ancrage (la branche Forage dépend d'Odyssey et n'existe pas sans
       l'extension). Aucune condition de dressage : le JobGiver ne répond que
       pour une bête de trait (BeteDeTrait.Est) qu'un colon a menée sur zone
       (en service) et équipée d'un harnais et d'un grattoir. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="Animal"]//li[@Class="ThinkNode_ChancePerHour_Constant"][.//trainable="Haul"]</xpath>
    <order>Append</order>
    <value>
      <li Class="ThinkNode_Tagger">
        <tagToGive>TrainedAnimalBehavior</tagToGive>
        <subNodes>
          <li Class="AnimalsAtWork.Plowing.JobGiver_Deneigeur" />
        </subNodes>
      </li>
    </value>
  </Operation>

</Patch>
