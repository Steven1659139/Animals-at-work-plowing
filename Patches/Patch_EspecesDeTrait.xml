<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Marque les bêtes de trait vanilla. Aucun dressage n'est requis ni
       modifié ; c'est BeteDeTrait.Est() qui tranche, et cette extension n'est
       qu'une de ses couches.
       La vache et l'âne sont les deux seules qui aient réellement besoin de
       cette liste : les autres sont des bêtes de somme (packAnimal) et
       seraient éligibles sans elle. On les garde tout de même, pour que le
       comportement vanilla ne dépende pas d'un drapeau qu'un autre mod
       pourrait retirer. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Horse" or defName="Donkey" or defName="Cow" or defName="Muffalo" or defName="Bison" or defName="Yak" or defName="Dromedary" or defName="Elephant"]</xpath>
    <value>
      <li Class="AnimalsAtWork.Plowing.ModExtension_BeteDeTrait" />
    </value>
  </Operation>

</Patch>
