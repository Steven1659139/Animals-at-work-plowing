<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Insère le comportement « labour » dans l'arbre de pensée des animaux
       apprivoisés, juste après la branche Haul (Core/ThinkTreeDefs/Animal.xml).
       L'ancrage est le bloc Haul et non le bloc Forage qui le suit : Forage
       porte MayRequire="Ludeon.RimWorld.Odyssey" et n'existe donc pas sans
       l'extension, ce qui faisait échouer le patch et laissait les bêtes
       équipées sans jamais travailler. Le bloc Haul, lui, est du jeu de base.
       L'ordre des trois patchs entre eux est sans importance : une bête ne
       porte qu'un attelage à la fois, donc un seul JobGiver peut répondre.
       Aucune condition de dressage : le JobGiver ne répond que pour une bête
       de trait (BeteDeTrait.Est : bête de somme, extension de def ou réglage
       du joueur) qu'un colon a menée au champ (en service) et équipée d'un
       harnais et d'une charrue. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="Animal"]//li[@Class="ThinkNode_ChancePerHour_Constant"][.//trainable="Haul"]</xpath>
    <order>Append</order>
    <value>
      <li Class="ThinkNode_Tagger">
        <tagToGive>TrainedAnimalBehavior</tagToGive>
        <subNodes>
          <li Class="AnimalsAtWork.Plowing.JobGiver_Labourer" />
        </subNodes>
      </li>
    </value>
  </Operation>

</Patch>
