<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Insère le comportement « labour » dans l'arbre de pensée des animaux
       apprivoisés, juste avant la branche Forage (Core/ThinkTreeDefs/Animal.xml).
       Aucune condition de dressage : le JobGiver ne s'active que pour les
       espèces de trait (ModExtension_BeteDeTrait) équipées d'un harnais et
       d'une charrue. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="Animal"]//li[@Class="ThinkNode_ConditionalTrainableCompleted"][trainable="Forage"]</xpath>
    <value>
      <li Class="ThinkNode_Tagger">
        <tagToGive>TrainedAnimalBehavior</tagToGive>
        <subNodes>
          <li Class="AnimalsAtWork.Plowing.JobGiver_Labourer" />
        </subNodes>
      </li>
    </value>
  </Operation>

</Patch>
